{
  "version": "0.1.0",
  "name": "energy_meter",
  "instructions": [
    {
      "name": "initializeConfig",
      "accounts": [
        { "name": "globalConfig", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "usdcMint", "isMut": false, "isSigner": false },
        { "name": "serviceVault", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "tariffUsdcPerPower", "type": "u64" },
        { "name": "oracle", "type": "publicKey" }
      ]
    },
    {
      "name": "updateTariff",
      "accounts": [
        { "name": "globalConfig", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "newTariffUsdcPerPower", "type": "u64" }
      ]
    },
    {
      "name": "initializeApartment",
      "accounts": [
        { "name": "apartment", "isMut": true, "isSigner": false },
        { "name": "globalConfig", "isMut": false, "isSigner": false },
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "deviceId", "type": "string" },
        { "name": "owner", "type": "publicKey" },
        { "name": "tenant", "type": "publicKey" }
      ]
    },
    {
      "name": "recordConsumption",
      "accounts": [
        { "name": "apartment", "isMut": true, "isSigner": false },
        { "name": "globalConfig", "isMut": false, "isSigner": false },
        { "name": "oracle", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "payUtilities",
      "accounts": [
        { "name": "apartment", "isMut": true, "isSigner": false },
        { "name": "tenant", "isMut": false, "isSigner": true },
        { "name": "tenantUsdc", "isMut": true, "isSigner": false },
        { "name": "ownerUsdc", "isMut": true, "isSigner": false },
        { "name": "serviceVault", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "GlobalConfig",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "admin", "type": "publicKey" },
          { "name": "oracle", "type": "publicKey" },
          { "name": "tariffUsdcPerPower", "type": "u64" },
          { "name": "usdcMint", "type": "publicKey" },
          { "name": "serviceVault", "type": "publicKey" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "Apartment",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "deviceId", "type": "string" },
          { "name": "ownerPubkey", "type": "publicKey" },
          { "name": "tenantPubkey", "type": "publicKey" },
          { "name": "accumulatedPower", "type": "u64" },
          { "name": "unpaidBalanceUsdc", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "Unauthorized", "msg": "Only the admin can perform this action" },
    { "code": 6001, "name": "UnauthorizedOracle", "msg": "Only the authorized Oracle can record consumption" },
    { "code": 6002, "name": "NotTenant", "msg": "Only the tenant can pay utilities" },
    { "code": 6003, "name": "OverPayment", "msg": "Payment amount exceeds unpaid balance" },
    { "code": 6004, "name": "ZeroConsumption", "msg": "Amount must be greater than zero" },
    { "code": 6005, "name": "ZeroPayment", "msg": "Payment must be greater than zero" },
    { "code": 6006, "name": "Overflow", "msg": "Arithmetic overflow" },
    { "code": 6007, "name": "TokenAccountMismatch", "msg": "Token account owner mismatch" }
  ],
  "metadata": {
    "address": "EMtr1111111111111111111111111111111111111111"
  }
}
